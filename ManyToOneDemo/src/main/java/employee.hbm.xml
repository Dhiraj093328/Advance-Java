<?xml version="1.0" encoding="UTF-8"?>
<hibernate-mapping>
    <class name="test.Employee" table="Employee12345">
        <id name="empid" column="empid">
            <generator class="increment"/>
        </id>

        <property name="name" column="ename"/>
        <property name="email" column="email"/>
        
        <many-to-one name="address" class="test.Address" column="address_id" cascade="all"/>
    </class>
</hibernate-mapping>
